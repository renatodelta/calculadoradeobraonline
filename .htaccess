RewriteEngine On

# Canonical URLs without explicit index.html
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+artigos/index\.html[\s?] [NC]
RewriteRule ^artigos/index\.html$ /artigos/ [R=301,L]

# Redirecionamentos 301 de URLs antigas para nova estrutura
RewriteRule ^concreto\.html$ /calculadoras/concreto.html [R=301,L,NC]
RewriteRule ^tijolos\.html$ /calculadoras/tijolos.html [R=301,L,NC]
RewriteRule ^piso\.html$ /calculadoras/piso.html [R=301,L,NC]
RewriteRule ^reboco\.html$ /calculadoras/reboco.html [R=301,L,NC]
RewriteRule ^quantos-tijolos-por-metro-quadrado\.html$ /artigos/quantos-tijolos-por-metro-quadrado.html [R=301,L,NC]
